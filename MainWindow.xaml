<Window x:Class="ExamHelper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Web 3 Exam Helper" Width="1280" Height="850" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="#F2F5FA" Foreground="#18243B">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="#112443" Padding="26,18"><StackPanel>
   <TextBlock Text="WEB 3  /  EXAM HELPER" FontSize="25" FontWeight="Bold" Foreground="White"/>
   <TextBlock Text="Inspect a repository. Find an explanation. Copy a pattern. Work offline." Foreground="#B8C9E8" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <TabControl Grid.Row="1" Margin="18,14,18,8" Background="White" BorderBrush="#DCE3EF">
   <TabItem Header="Repository scanner">
    <Grid Margin="18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Content="Export report" Click="ExportReport_Click"/><Button DockPanel.Dock="Right" x:Name="ScanButton" Content="Scan folder" Click="Scan_Click"/><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/><TextBox x:Name="RepoPath" ToolTip="Choose the repository root, not its bin/obj folder"/></DockPanel>
     <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="#576984" Text="Read-only checks of C# source. Findings are review prompts, not proof of missing features or exam compliance." TextWrapping="Wrap"/>
     <Border Grid.Row="2" Background="#F0F5FF" Padding="12" Margin="0,10,0,10"><TextBlock x:Name="ScanSummary" Text="Choose a repository to discover projects, types, route attributes and common refactoring concerns. No code or commands run during scanning." TextWrapping="Wrap"/></Border>
     <TabControl Grid.Row="3" BorderBrush="#DCE3EF">
      <TabItem Header="Review findings"><DataGrid x:Name="FindingsGrid" SelectionChanged="Finding_Selected"><DataGrid.Columns>
       <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="85"/><DataGridTextColumn Header="Review" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="260"/><DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="55"/>
      </DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="Projects / types / routes"><DataGrid x:Name="InventoryGrid" SelectionChanged="Inventory_Selected"><DataGrid.Columns>
       <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="Name / declaration" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="280"/><DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="55"/>
      </DataGrid.Columns></DataGrid></TabItem>
     </TabControl>
     <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" Content="Open source" Click="OpenSource_Click" Padding="10,4"/><TextBlock x:Name="FindingDetail" Text="Select a finding or inventory item to see its explanation and source context." TextWrapping="Wrap" Margin="0,0,12,6"/></DockPanel>
      <TextBox x:Name="SourcePreview" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#F8FAFD"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Offline notes">
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox x:Name="NotesSearch" TextChanged="NotesFilter_Changed" ToolTip="Search headings AND full section text"/>
      <TextBlock Grid.Row="1" Text="Search notes by topic, class or question" Foreground="#64748B" Margin="0,7,0,10"/>
      <ListBox x:Name="SectionsList" Grid.Row="2" SelectionChanged="Note_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,7"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" Content="Copy section" Click="CopyNote_Click"/><TextBlock x:Name="NoteTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,8,0"/></DockPanel>
      <TextBlock Grid.Row="1" x:Name="NoteMatch" Margin="0,8,0,10" Foreground="#64748B" Text="Notes are embedded in the executable; no network is needed."/>
      <TextBox Grid.Row="2" x:Name="NoteBody" IsReadOnly="True" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFBFE"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Code templates">
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="YOUR PROJECT" FontWeight="Bold" Foreground="#64748B"/><TextBlock Text="Namespace" Margin="0,14,0,5"/><TextBox x:Name="NamespaceInput" Text="YourApi" TextChanged="TemplateInput_Changed"/><TextBlock Text="Entity name (singular)" Margin="0,12,0,5"/><TextBox x:Name="EntityInput" Text="Product" TextChanged="TemplateInput_Changed"/><TextBlock Text="Examples assume an int Id and string Name. Adapt fields, relationships, rules and routes before using them." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12,0,14"/></StackPanel>
      <ListBox Grid.Row="1" x:Name="TemplatesList" DisplayMemberPath="Title" SelectionChanged="Template_Selected"/>
     </Grid>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" Content="Copy template" Click="CopyTemplate_Click"/><TextBlock x:Name="TemplateTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/></DockPanel>
      <TextBlock Grid.Row="1" x:Name="TemplateHelp" Margin="0,10,0,12" Foreground="#576984" TextWrapping="Wrap"/>
      <TextBox Grid.Row="2" x:Name="TemplateBody" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFBFE"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Exam checklist">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30" MaxWidth="900" HorizontalAlignment="Left">
     <TextBlock Text="Start with the actual exam sheet" FontSize="25" FontWeight="Bold"/>
     <TextBlock Margin="0,10,0,20" Text="These checkboxes are session-only reminders. The app does not grade your repository. Select only requirements that actually apply." TextWrapping="Wrap" Foreground="#64748B"/>
     <CheckBox Content="Read README / exam sheet; identify startup project, SDK and provider" Margin="0,7"/>
     <CheckBox Content="Record routes, DTO fields, status codes, Location headers and exact errors" Margin="0,7"/>
     <CheckBox Content="Map relationships, indexes, delete rules and ordered business checks" Margin="0,7"/>
     <CheckBox Content="Build the unchanged starter and record existing tests" Margin="0,7"/>
     <CheckBox Content="Move rules to services; keep controllers thin and response DTOs stable" Margin="0,7"/>
     <CheckBox Content="Implement required repositories / factory / Unit of Work with scoped lifetimes" Margin="0,7"/>
     <CheckBox Content="Keep required filters, joins, groups, sums and paging in EF queries" Margin="0,7"/>
     <CheckBox Content="Commit related row changes once; use tracked allowed-field updates" Margin="0,7"/>
     <CheckBox Content="Add required migrations, validation, audit and structured logging" Margin="0,7"/>
     <CheckBox Content="Add requested cache and invalidate only after successful commit" Margin="0,7"/>
     <CheckBox Content="Apply real scope map; verify anonymous / wrong-scope / allowed calls" Margin="0,7"/>
     <CheckBox Content="Test a write followed by a separate HTTP read on isolated database" Margin="0,7"/>
     <CheckBox Content="Run required tests, inspect staged files, complete README and review answers" Margin="0,7"/>
     <CheckBox Content="Submit the correct branch; exclude secrets, runtime databases, bin and obj" Margin="0,7"/>
     <TextBlock Text="The eight review answers are in Offline notes. Search: REVIEW ANSWER" Foreground="#275BE8" Margin="0,25,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="2" Text="Ready • offline • source inspection only" Margin="24,3" Foreground="#64748B" FontSize="12"/>
 </Grid>
</Window>
